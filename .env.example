# ============================================================
# DRIFT — environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored. Never commit real secrets.
# ============================================================

# --- Database ---
POSTGRES_DB=drift
POSTGRES_USER=drift
POSTGRES_PASSWORD=change_me_in_production

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Django ---
DJANGO_SECRET_KEY=change_me_to_a_random_50_char_string
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- OpenAI (L4 briefing) ---
OPENAI_API_KEY=sk-...

# --- KHOA 조류예보 API (국립해양조사원) ---
# 발급: https://www.khoa.go.kr/oceandataportal/service/openApiIntro.do
KHOA_API_KEY=your_khoa_key_here

# --- KMA 기상청 초단기실황 API ---
# 발급: https://www.data.go.kr → "기상청_단기예보 ((구)_동네예보) 조회서비스"
# ※ URL-encode 이전 원본 인증키를 그대로 입력
KMA_API_KEY=your_kma_key_here

# --- AWS (PDF 업로드) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=drift-reports
AWS_REGION=ap-northeast-2

# --- Feature flags ---
ENGINE_PARTICLE_COUNT=1000
ENGINE_L3_MIN_TRAINING_RECORDS=30
